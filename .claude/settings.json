{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "qarga-coordinator",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run validate:claude)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(node --check *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git grep *)",
      "Bash(npm run learning:review)",
      "Bash(node scripts/review-learning-signals.mjs)",
      "Bash(npm run test:claude-system)",
      "Bash(npm run security:claude)",
      "Bash(npm run security:secrets)",
      "Bash(npm run system:health *)",
      "Bash(npm run agent-ops:report)",
      "Bash(npm run task:review)",
      "Bash(npm run evolution:review)",
      "Bash(npm run e2e:check)",
      "Bash(git branch --show-current)",
      "Bash(npm run web:budget)",
      "Bash(npm run work-os -- *)",
      "Bash(npm run work-os:summary)",
      "Bash(npm run work-os:validate)",
      "Bash(npm run work-os:review)",
      "Bash(npm run work-os:export)",
      "Bash(npm run skill-evolution:review)",
      "Bash(npm run skill:audit)",
      "Bash(npm run skill-evolution:evaluate -- *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run db:reset)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm run performance:record *)",
      "Bash(npm run learning:record *)",
      "Bash(npx -y ecc-agentshield *)",
      "Bash(npm run task:record *)",
      "Bash(npm run task:progress *)",
      "Bash(npm run evolution:record *)",
      "Bash(npm run load:smoke *)",
      "Bash(npm install -D @playwright/test)",
      "Bash(npx playwright install *)",
      "Bash(npm run work-os:serve *)",
      "Bash(npm run skill-evolution:record -- *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./server/.env)",
      "Read(./server/.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.production)",
      "Write(./.env.development)",
      "Write(./.env.test)",
      "Write(./server/.env)",
      "Write(./server/.env.*)",
      "Write(./secrets/**)",
      "Write(./config/credentials.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Edit(./.env.test)",
      "Edit(./server/.env)",
      "Edit(./server/.env.*)",
      "Edit(./secrets/**)",
      "Edit(./config/credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-command.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan-staged-secrets.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-lifecycle-logger.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-lifecycle-logger.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
