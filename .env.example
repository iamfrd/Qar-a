# API serveri
PORT=3001

# Verilənlər bazası faylının yolu.
# Boş buraxılsa server/data/qarga.db istifadə olunur.
QARGA_DB=

# Produksiyada 'production' olmalıdır. Bu zaman:
#  - OTP kodu cavabda qaytarılmır
#  - sessiya cookie-si Secure bayrağı alır
NODE_ENV=development

# Frontend hansı API-ya proxy etsin (Vite dev serveri üçün)
VITE_API_TARGET=http://localhost:3001
